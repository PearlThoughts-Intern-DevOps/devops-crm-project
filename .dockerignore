# Dependencies (installed fresh inside the image)
node_modules/
.yarn/
!.yarn/releases
!.yarn/patches
!.yarn/plugins

# Version control
.git/
.github/

# Build/test output and local dev artifacts
dist/
build/
.twenty/
coverage/

# Env/secrets — never bake these into an image
.env
.env.*

# Editor/OS cruft
.vscode/
.idea/
.DS_Store

# Docs not needed at build time
*.md
*.pdf
