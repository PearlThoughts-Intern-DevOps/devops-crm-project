# Don't copy these into the Docker build context

node_modules
.git
.github

# generated build output from the twenty CLI - gets rebuilt inside the container
.twenty/output

# editor/OS files
.vscode
.idea
.DS_Store

# secrets - never bake these into the image
.env
.env.*
!.env.example

# logs
*.log

# docs (not needed to run the app)
*.md
!README.md