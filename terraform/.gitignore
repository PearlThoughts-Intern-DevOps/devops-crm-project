# State files — contain sensitive resource details, never commit
terraform.tfstate
terraform.tfstate.backup

# Variable values — contain AWS credentials and sensitive config
terraform.tfvars

# Terraform internals
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
