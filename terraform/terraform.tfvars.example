aws_region          = "us-east-1"
project_name        = "devops-crm"
environment         = "dev"
availability_zone   = "us-east-1a"
instance_type       = "t3.small"
root_volume_size    = 20
application_port    = 2020
ecr_repository_name = "twenty-crm"

# Example only: replace with a real x86_64 Linux AMI ID in your region.
# This placeholder has the expected format but is not a usable AMI.
ami_id = "ami-00000000000000000"

# Documentation-only addresses: replace with your public IPv4 address
# followed by /32 before attempting real access.
ssh_allowed_cidr         = "203.0.113.10/32"
application_allowed_cidr = "203.0.113.10/32"
