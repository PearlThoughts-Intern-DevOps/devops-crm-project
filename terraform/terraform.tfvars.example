aws_region        = "us-east-1"
project_name      = "devops-crm"
environment       = "dev"
availability_zone = "us-east-1a"

# Task 15 permits only t3.small and the two approved AMIs.
instance_type    = "t3.small"
ami_id           = "ami-081b0a6eac00b4f53"
root_volume_size = 20

# Twenty listens on container port 3000. This value is its EC2 host port.
application_port = 3000
twenty_version   = "v2.38.1"

# Replace these documentation-only values before planning.
# Terraform imports the local public key and never reads the private key.
ssh_allowed_cidr         = "203.0.113.10/32"
key_name                 = "chirag-crm-server"
ssh_public_key_path = "~/.ssh/chirag-crm-server.pub"
associate_public_ip_address = true