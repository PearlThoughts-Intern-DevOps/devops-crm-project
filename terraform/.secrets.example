# ============================================================
# .secrets.example — Template for secrets
# Copy this file to .secrets and fill in real values
# NEVER commit .secrets to git
# ============================================================

# Generate pg_password:    use any strong password
# Generate encryption_key: openssl rand -hex 16
# Generate app_secret:     openssl rand -hex 16

export TF_VAR_pg_password="your-strong-password-here"
export TF_VAR_encryption_key="your-32-char-hex-key-here"
export TF_VAR_app_secret="your-32-char-hex-secret-here"
