aws_region        = "us-east-1"
project_name      = "devops-crm"
environment       = "dev"
ami_id            = "ami-081b0a6eac00b4f53"
instance_type     = "t3.small"
root_volume_size  = 20
application_port  = 2020
ssh_user          = "ec2-user"

# Replace these example values locally.
key_name          = "your-existing-key-pair"
ssh_allowed_cidr  = "203.0.113.10/32"
private_key_path  = "~/.ssh/your-key.pem"