# Copy this file to terraform.tfvars and adjust the values for your environment.
# terraform.tfvars is gitignored so real values never get committed.

aws_region       = "us-east-1"
project_name     = "twenty-crm"
environment      = "dev"

instance_type    = "t3.medium"
key_pair_name    = "my-ec2-keypair"   # must already exist in the target AWS account
ssh_allowed_cidr = "203.0.113.10/32"  # restrict to your own IP, avoid 0.0.0.0/0
app_port         = 3000
root_volume_size = 30

ecr_repository_name     = "twenty-crm"
ecr_image_tag_mutability = "MUTABLE"
ecr_scan_on_push         = true

tags = {
  Owner = "your-name"
}
