services:

  twenty:
    image: {{ twenty_image }}
    container_name: twenty-crm
    restart: unless-stopped

    ports:
      - "{{ app_port }}:3000"

    env_file:
      - .env

    environment:
      SERVER_URL: "http://{{ ansible_host }}:{{ app_port }}"
      PG_DATABASE_URL: "postgres://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}"
      REDIS_URL: "redis://redis:6379"
      STORAGE_TYPE: "local"
      APP_SECRET: "{{ app_secret }}"
      NODE_ENV: "production"
      DISABLE_DB_MIGRATIONS: "false"
      DISABLE_CRON_JOBS_REGISTRATION: "false"
      IS_BILLING_ENABLED: "false"

    volumes:
      - twenty-storage:/app/packages/twenty-server/.local-storage

    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

    healthcheck:
      test:
        - CMD-SHELL
        - curl --fail http://localhost:3000/healthz || exit 1
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

    networks:
      - twenty-network

  postgres:
    image: {{ postgres_image }}
    container_name: twenty-postgres
    restart: unless-stopped

    environment:
      POSTGRES_USER: "{{ postgres_user }}"
      POSTGRES_PASSWORD: "{{ postgres_password }}"
      POSTGRES_DB: "{{ postgres_db }}"

    volumes:
      - postgres-data:/var/lib/postgresql/data

    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U {{ postgres_user }} -d {{ postgres_db }}
      interval: 5s
      timeout: 5s
      retries: 10

    networks:
      - twenty-network

  redis:
    image: {{ redis_image }}
    container_name: twenty-redis
    restart: unless-stopped

    command:
      - redis-server
      - --maxmemory-policy
      - noeviction

    healthcheck:
      test:
        - CMD
        - redis-cli
        - ping
      interval: 5s
      timeout: 5s
      retries: 10

    networks:
      - twenty-network

volumes:
  twenty-storage:
  postgres-data:

networks:
  twenty-network:
    driver: bridge