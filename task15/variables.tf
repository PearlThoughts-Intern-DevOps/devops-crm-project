variable "aws_region" {
  description = "AWS region"
  type        = string
  default     = "us-east-1"
}

variable "instance_type" {
  description = "EC2 instance type"
  type        = string
  default     = "t3.small"
}

variable "ami_id" {
  description = "EC2 AMI ID"
  type        = string
  default     = "ami-0b6d9d3d33ba97d99"
}