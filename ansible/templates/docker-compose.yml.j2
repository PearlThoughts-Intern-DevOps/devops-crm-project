services:

  server:
    image: {{ twenty_image }}
    container_name: twenty-server
    restart: {{ restart_policy }}
    ports:
      - "{{ app_port }}:3000"
    environment:
      NODE_PORT: 3000
      SERVER_URL: "http://{{ ansible_host }}:{{ app_port }}"
      PG_DATABASE_URL: "postgresql://{{ postgres_user }}:{{ postgres_password }}@db:5432/{{ postgres_db }}"
      REDIS_URL: "redis://redis:6379"
      ENCRYPTION_KEY: "{{ twenty_encryption_key }}"
    # Uses wget for a lightweight HTTP health check against the Twenty CRM server.
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://localhost:3000/ || exit 1"]
      interval: {{ health_check_interval }}
      timeout: {{ health_check_timeout }}
      retries: {{ health_check_retries }}
      start_period: {{ health_check_start_period }}
    depends_on:
      - db
      - redis

  worker:
    image: {{ twenty_image }}
    container_name: twenty-worker
    restart: {{ restart_policy }}
    command: ["yarn", "worker:prod"]
    environment:
      NODE_PORT: 3000
      PG_DATABASE_URL: "postgresql://{{ postgres_user }}:{{ postgres_password }}@db:5432/{{ postgres_db }}"
      REDIS_URL: "redis://redis:6379"
      ENCRYPTION_KEY: "{{ twenty_encryption_key }}"
    depends_on:
      - db
      - redis

  db:
    image: {{ postgres_image }}
    container_name: twenty-postgres
    restart: {{ restart_policy }}
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ postgres_password }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }} -d {{ postgres_db }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    volumes:
      - twenty-db-data:/var/lib/postgresql/data

  redis:
    image: {{ redis_image }}
    container_name: twenty-redis
    restart: {{ restart_policy }}
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    volumes:
      - twenty-redis-data:/data

volumes:
  twenty-db-data:
  twenty-redis-data:
