services:
  server:
    image: twentycrm/twenty:{{ twenty_image_tag }}
    ports:
      - "{{ twenty_app_port }}:3000"
    environment:
      PG_DATABASE_URL: postgres://{{ twenty_pg_user }}:${PG_DATABASE_PASSWORD}@{{ twenty_pg_host }}:{{ twenty_pg_port }}/{{ twenty_pg_database }}
      SERVER_URL: ${SERVER_URL}
      REDIS_URL: ${REDIS_URL}
      STORAGE_TYPE: ${STORAGE_TYPE}
      ENCRYPTION_KEY: ${ENCRYPTION_KEY}
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test:
        - CMD
        - curl
        - -f
        - http://localhost:3000/healthz
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 30s

  worker:
    image: twentycrm/twenty:{{ twenty_image_tag }}
    command: ["yarn", "worker:prod"]
    environment:
      PG_DATABASE_URL: postgres://{{ twenty_pg_user }}:${PG_DATABASE_PASSWORD}@{{ twenty_pg_host }}:{{ twenty_pg_port }}/{{ twenty_pg_database }}
      SERVER_URL: ${SERVER_URL}
      REDIS_URL: ${REDIS_URL}
      STORAGE_TYPE: ${STORAGE_TYPE}
      ENCRYPTION_KEY: ${ENCRYPTION_KEY}
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy

  db:
    image: postgres:16
    environment:
      POSTGRES_USER: ${PG_DATABASE_USER}
      POSTGRES_PASSWORD: ${PG_DATABASE_PASSWORD}
      POSTGRES_DB: {{ twenty_pg_database }}
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U ${PG_DATABASE_USER} -d {{ twenty_pg_database }}
      interval: 10s
      timeout: 5s
      retries: 10
    volumes:
      - twenty-db-data:/var/lib/postgresql/data

  redis:
    image: redis
    healthcheck:
      test:
        - CMD
        - redis-cli
        - ping
      interval: 10s
      timeout: 5s
      retries: 10
    volumes:
      - twenty-redis-data:/data

volumes:
  twenty-db-data:
  twenty-redis-data:
