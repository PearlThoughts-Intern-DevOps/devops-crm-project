{
  "metrics": {
    "namespace": "TwentyCRM/EC2",
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 60
      },
      "disk": {
        "resources": ["/"],
        "measurement": ["disk_used_percent"],
        "metrics_collection_interval": 60
      },
      "cpu": {
        "resources": ["*"],
        "measurement": ["cpu_usage_user", "cpu_usage_idle"],
        "metrics_collection_interval": 60
      }
    }
  }
}
