# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# codegen
generated

# testing
/coverage

# dev
/dist/

.twenty

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env
# typescript
*.tsbuildinfo
*.d.ts

*.swp
*.swo

# =============================================================================
# .dockerignore — Twenty CRM
# Excludes files/dirs from the Docker build context to:
#   • Speed up builds (smaller context sent to daemon)
#   • Prevent secrets from leaking into the image
#   • Keep the image lean
# =============================================================================

# ── Version Control ───────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github

# ── Node Modules ──────────────────────────────────────────────────────────────
# Rebuilt inside the image; never copy from host
node_modules
**/node_modules

# ── Build Artifacts ───────────────────────────────────────────────────────────
# Will be generated during image build
dist
build
.next
out

# ── Environment & Secrets ─────────────────────────────────────────────────────
# NEVER bake secrets into the image
.env
.env.*
!.env.example       # Allow the example file for reference only

# ── Test & Coverage ───────────────────────────────────────────────────────────
coverage
**/*.test.ts
**/*.spec.ts
**/__tests__
jest.config.*
vitest.config.*

# ── Documentation ─────────────────────────────────────────────────────────────
docs
*.md
LICENSE
CHANGELOG*

# ── Docker files themselves ───────────────────────────────────────────────────
Dockerfile*
docker-compose*.yml
.dockerignore

# ── Editor & OS artifacts ─────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Cache directories ─────────────────────────────────────────────────────────
.cache
.turbo
.nx
.eslintcache
.stylelintcache

# ── CI/CD config ─────────────────────────────────────────────────────────────
.circleci
.travis.yml
Jenkinsfile
*.gitlab-ci.yml

# ── Local storage & uploads ───────────────────────────────────────────────────
# Managed via Docker volumes, not baked in
.local-storage
uploads

# ── Terraform / IaC ──────────────────────────────────────────────────────────
*.tfstate
*.tfvars
.terraform

