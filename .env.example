# Copy this file to .env and fill in real values before running
# docker compose up.

# Postgres
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=change-me
PG_DATABASE_NAME=default

# Twenty server
TWENTY_VERSION=latest
TWENTY_PORT=3000
SERVER_URL=http://localhost:3000

# Required — generate with: openssl rand -base64 32
# Losing this secret after data exists means losing access to encrypted
# secrets stored in the database. Keep it safe, never commit the real value.
APP_SECRET=
