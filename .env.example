# ==========================================================
# Application Configuration
# ==========================================================
NODE_ENV=development
PORT=3000

# ==========================================================
# Twenty CRM Server Connection Settings
# ==========================================================
# When running within Docker Compose, connect to the twenty-server service name:
TWENTY_API_URL=http://twenty-server:2020
TWENTY_API_KEY=dev-api-key-for-local-testing

# Server Host URL for external access
SERVER_URL=http://localhost:2020

# ==========================================================
# Database & Cache (Internal to Twenty Dev Container)
# ==========================================================
PG_DATABASE_URL=postgres://twenty:twenty@localhost:5432/default
REDIS_URL=redis://localhost:6379
STORAGE_TYPE=local
