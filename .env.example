# .env.example – Copy to .env and fill in your values before running
# docker compose up.  The .env file is git-ignored.


# Image version to use (e.g. "2.35.0", "latest")
TWENTY_VERSION=latest

# Port the Twenty web UI / API is bound to on the HOST machine
SERVER_PORT=2020

# URL at which the server is reachable from the HOST (for browser)
SERVER_URL=http://localhost:2020

# Secret used to sign JWTs – change this in any non-local environment!
APP_SECRET=twenty-app-dev-secret-not-for-production

# Node environment
NODE_ENV=development

# Docker image tag for the built app image
APP_VERSION=local

# URL of the Twenty server reachable from inside Docker (service name)
TWENTY_API_URL=http://twenty-server:2020

# API key from Settings → API & Webhooks → Create.
# Leave blank on first run; the server creates it after initialisation.
TWENTY_API_KEY=